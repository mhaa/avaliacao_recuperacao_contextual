# Claude Code
.claude/
CLAUDE.local.md
.claude.json
.mcp.json
CLAUDE.md

# data_generation — dados gerados/baixados e ambiente virtual, nunca versionados
data_generation/data/
data_generation/.venv/
data_generation/*.egg-info/
__pycache__/
*.pyc
.pytest_cache/

# venv da raiz — `pip install -e .` para rodar analysis/report.py (e outros
# scripts de host, ver pyproject.toml) fora do Docker.
.venv/
*.egg-info/

# load/fixtures — derivado de data_generation/data/ por
# load/export_contexts_by_tier.py, regenerável, nunca versionado.
load/fixtures/*
!load/fixtures/.gitkeep

# results/ — saída bruta de load/run_battery.py (docs/ARCHITECTURE.md,
# "Coleta de resultados"): git-ignored exceto .gitkeep.
results/*
!results/.gitkeep

# Execuções arquivadas por serem inválidas (mediram o gargalo do serviço,
# não os bancos — ver commits 6347fdb/55ac52a). Ficam fora de results/ para
# o glob de analysis/report.py não misturá-las no relatório, e fora do git
# pelo mesmo motivo que results/: são ~12 GB de saída bruta do k6.
resultados-invalidos-pre-correcao/

# infra/ (Terraform, Etapa 9) — cache de provedores, estado (mesmo o local
# de infra/bootstrap) e variáveis reais nunca são versionados.
# .terraform.lock.hcl FICA versionado (docs/ARCHITECTURE.md) — não entra aqui.
infra/**/.terraform/
infra/**/*.tfstate
infra/**/*.tfstate.*
infra/**/.terraform.tfstate.lock.info
infra/**/terraform.tfvars
!infra/**/terraform.tfvars.example

# Zip gerado por data.archive_file (budget_killswitch) a cada
# init/plan/apply — build artifact, não código-fonte.
infra/**/function_src.zip

# Chave da service account do Terraform (Fase 4) — NUNCA deveria existir
# dentro do repo (infra/scripts/create_terraform_service_account.sh gera a
# chave fora da árvore do Git de propósito e se recusa a escrever aqui),
# mas ignorado por precaução (defesa em profundidade, não a proteção
# principal).
*-key.json
infra/.gcp/
