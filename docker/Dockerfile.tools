# Imagem de ferramentas — Python + pytest + k6 para rodar a suíte de testes
# e a geração de carga do serviço de recuperação (core/, storage/,
# strategies/, harness/, load/ etc. conforme cada etapa de
# docs/ARCHITECTURE.md for implementada). Isolada do host, mesma lógica de
# data_generation/Dockerfile: nada de Python ou k6 precisa estar instalado
# fora do Docker (docs/ARCHITECTURE.md, "Ambiente local — Docker").

FROM grafana/k6:0.54.0 AS k6
FROM hashicorp/terraform:1.9.8 AS terraform

FROM python:3.11-slim

WORKDIR /app

# Binário oficial do k6, copiado da imagem grafana/k6 — Etapa 7 (load/).
COPY --from=k6 /usr/bin/k6 /usr/local/bin/k6

# Binário oficial do Terraform — Etapa 9 (infra/), só para `fmt`/`validate`
# nesta fase (nenhum `plan`/`apply` real sem projeto GCP de verdade).
COPY --from=terraform /bin/terraform /usr/local/bin/terraform

# git ainda é útil para ferramentas locais, mas NÃO é o que abastece o
# manifest.json: o código chega aqui por COPY, sem `.git`, então
# `git rev-parse HEAD` sempre falhou dentro do contêiner e
# load/run_battery.py gravava `"git_commit": ""` em silêncio (confirmado em
# results/e4-postgres/triagem/20260906T155013Z). O hash agora é injetado no
# build e lido de TCC_GIT_COMMIT — ver load/run_battery.py:_git_commit e
# infra/scripts/build_and_push_images.sh, que passa --build-arg.
RUN apt-get update && apt-get install -y --no-install-recommends git \
    && rm -rf /var/lib/apt/lists/*

ARG GIT_COMMIT=""
ENV TCC_GIT_COMMIT=$GIT_COMMIT

COPY pyproject.toml ./
COPY core ./core
COPY storage ./storage
COPY strategies ./strategies
COPY harness ./harness
COPY schemas ./schemas
COPY cells ./cells
COPY service ./service
COPY tests ./tests
COPY load ./load
COPY analysis ./analysis

# Fixture do oráculo (harness/fixtures.py) — só o que ele de fato lê, não
# a massa completa (data_generation/data/raw/ e inverted_bitmaps/ ficam
# de fora, ~1GB a menos). Localmente isso chega via o volume montado em
# docker-compose.yml; na nuvem (infra/modules/loadgen) não existe bind
# mount nenhum, então sem isso o smoke test falha com FileNotFoundError
# assim que schemas/postgres/load_oracle_fixture.py tenta ler
# oracle.parquet — confirmado rodando de verdade contra uma VM real.
COPY data_generation/data/oracle.parquet ./data_generation/data/oracle.parquet
COPY data_generation/data/candidates.parquet ./data_generation/data/candidates.parquet
COPY data_generation/data/prematerialized.parquet ./data_generation/data/prematerialized.parquet
COPY data_generation/data/items.parquet ./data_generation/data/items.parquet
COPY data_generation/data/contexts.parquet ./data_generation/data/contexts.parquet
COPY data_generation/data/inverted_lists.parquet ./data_generation/data/inverted_lists.parquet

RUN pip install --no-cache-dir -e ".[dev]"

ENTRYPOINT ["python", "-m", "pytest"]
CMD ["-m", "not integration"]
