# Imagem do serviço de recuperação — um único binário, uma única imagem
# para todas as 14 células (a célula é escolhida em runtime via CELL, ver
# docs/ARCHITECTURE.md, "princípio que governa todas as decisões"). Multi-stage,
# final slim, usuário não-root, sem ferramentas de build.

FROM python:3.11-slim AS builder

WORKDIR /app

COPY pyproject.toml ./
COPY core ./core
COPY storage ./storage
COPY strategies ./strategies
COPY service ./service
# harness/, load/ e analysis/ não são usados em runtime pelo serviço, mas
# pyproject.toml declara os três em "packages" (compartilhado com
# Dockerfile.tools) — pip install . (não editável) valida que todo pacote
# listado existe fisicamente. Descartados junto com o resto deste estágio
# builder.
COPY harness ./harness
COPY load ./load
COPY analysis ./analysis

RUN pip install --no-cache-dir --prefix=/install .

FROM python:3.11-slim

WORKDIR /app

RUN useradd --create-home --shell /usr/sbin/nologin appuser

COPY --from=builder /install /usr/local
COPY core ./core
COPY storage ./storage
COPY strategies ./strategies
COPY cells ./cells
COPY service ./service

USER appuser

EXPOSE 8000 50051

ENTRYPOINT ["python", "-m", "service.main"]
