# Copie para terraform.tfvars e preencha com valores reais.
# terraform.tfvars NUNCA é commitado (ver .gitignore) — só este .example,
# com placeholders (docs/ARCHITECTURE.md: "Nenhum segredo em código ou em
# .tfvars versionado").

project_id    = "your-gcp-project-id"
region        = "us-east4"
zone          = "us-east4-a"
cell          = "e1-postgres"
storage       = "postgres"
service_image = "us-east4-docker.pkg.dev/your-gcp-project-id/tcc/service:latest"
tools_image   = "us-east4-docker.pkg.dev/your-gcp-project-id/tcc/tools:latest"
